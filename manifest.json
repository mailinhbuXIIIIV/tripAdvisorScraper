{
  "manifest_version": 3,
  "name": "TripAdvisor Data Scraper",
  "version": "3.0",
  "description": "Scrape TripAdvisor listing data and export as CSV",
  "permissions": ["tabs", "scripting", "downloads", "sidePanel", "storage"],
  "host_permissions": ["https://www.tripadvisor.com/*", "https://n8n.excelogy.net/*"],
  "action": {
    "default_title": "Open TA Scraper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}